   <string notr="true">
    QWidget#SettingsPage {
        background-color: #2b2b2b;
        color: #f0f0f0;
        font-family: sans-serif;
        font-size: 14px;
    }
    QGroupBox {
        border: 1px solid #3d3d3d;
        border-radius: 6px;
        margin-top: 24px;
        font-weight: bold;
        font-size: 15px;
        background-color: #333333;
    }
    QGroupBox::title {
        subcontrol-origin: margin;
        subcontrol-position: top left;
        left: 20px;
        padding: 0 5px;
        color: #00bfff;
    }
    QLabel {
        color: #cccccc;
        font-size: 14px;
    }
    QLineEdit {
        background-color: #202020;
        border: 1px solid #555;
        border-radius: 4px;
        padding: 4px;
        color: #ffffff;
        font-family: monospace;
        font-weight: bold;
        selection-background-color: #00bfff;
    }
    QLineEdit:focus {
        border: 1px solid #00bfff;
        background-color: #252525;
    }
    QPushButton {
        background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #00bfff, stop:1 #009acd);
        color: white;
        border: none;
        border-radius: 4px;
        padding: 8px 16px;
        font-weight: bold;
        font-size: 15px;
    }
    QPushButton:hover {
        background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1ec0ff, stop:1 #1e90ff);
    }
    QPushButton:pressed {
        background-color: #007acc;
        padding-top: 10px;
        padding-bottom: 6px;
    }
    QCheckBox {
        spacing: 8px;
        color: #dddddd;
    }
    QCheckBox::indicator {
        width: 18px;
        height: 18px;
        border: 1px solid #666;
        border-radius: 3px;
        background: #202020;
    }
    QCheckBox::indicator:checked {
        background-color: #00bfff;
        border-color: #00bfff;
        image: url(:/icons/check.png); /* Ensure you have an icon or remove this line if not */
    }
    QCheckBox::indicator:unchecked:hover {
        border-color: #00bfff;
    }
   </string>
